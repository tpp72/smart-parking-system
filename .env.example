APP_NAME="Smart Parking"
APP_ENV=local
APP_KEY=                        # [ต้องทำ] รัน: php artisan key:generate
APP_DEBUG=false                  # [local เท่านั้น] เปลี่ยนเป็น true เพื่อดูรายละเอียด error ตอนพัฒนา
APP_URL=http://localhost

# โลโก้ระบบ (ไม่ตั้ง = ใช้ตรา "P" ที่วาดด้วย HTML) — path จากโฟลเดอร์ public เช่น images/brand-logo.svg
BRAND_LOGO=                      # [ไม่ต้องตั้ง] เว้นว่าง = ใช้ public/favicon.svg · ตั้งเป็น path จาก public เพื่อเปลี่ยนไอคอนบนเว็บ
BRAND_LOGO_EMAIL=                # [ไม่ต้องตั้ง] เว้นว่าง = ใช้ public/brand-icon-email.png · อีเมลต้องเป็น PNG/JPG เท่านั้น
BRAND_LOGO_HEIGHT=32

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ───
# [ต้องทำ] สร้าง database ชื่อ smart-parking-system แล้วแก้ password ด้านล่าง
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart-parking-system
# แนะนำให้สร้างบัญชีเฉพาะโปรเจกต์ (ต้องมีสิทธิ์ CREATEDB สำหรับฐานทดสอบ) แทนการใช้ superuser postgres
DB_USERNAME=smart_parking
DB_PASSWORD=                    # [ต้องทำ] ใส่ password PostgreSQL ของเครื่องตัวเอง

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ─── Mail ───
# [ต้องทำ] ถ้าต้องการส่งเมล ให้แก้ค่าด้านล่าง (ไม่ได้ใช้ก็ปล่อยไว้แบบนี้)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com         # ส่งผ่าน Resend (โดเมน tpp72.com ต้อง verify ใน Resend ก่อน)
MAIL_PORT=587                     # ถ้าเซิร์ฟเวอร์บล็อก 587 ใช้ 2587 แทน (ถ้าใช้ 465 ต้องตั้ง MAIL_SCHEME=smtps)
MAIL_USERNAME=resend
MAIL_PASSWORD=                    # [ต้องทำ] Resend API key (สิทธิ์ Sending access)
MAIL_FROM_ADDRESS="noreply@tpp72.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── AI Car Scan (Anthropic Claude Vision) ───
# [ต้องทำ] ขอ API Key ที่ https://console.anthropic.com
ANTHROPIC_API_KEY=              # [ต้องทำ] ใส่ Anthropic API Key (sk-ant-...)
CARSCAN_MODEL=claude-opus-4-8   # (optional) เปลี่ยน model ได้ที่นี่
CARSCAN_VERIFY_SSL=true
CARSCAN_FAKE=false              # true = จำลองผล AI จากชื่อไฟล์ (เฉพาะ APP_ENV=local/testing) — ใช้กับ E2E
# โมเดลที่ใช้ได้:
# claude-opus-4-8           → แม่นที่สุด  ✅ แนะนำสำหรับอ่านป้ายทะเบียนไทย
# claude-haiku-4-5          → เร็วและถูกกว่า เหมาะกับการทดสอบ
